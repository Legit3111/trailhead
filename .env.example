# Copy to .env.local and fill in. NEVER commit real values.
# Anthropic API key — server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Optional: override the model (defaults to claude-sonnet-4-5).
ANTHROPIC_MODEL=claude-sonnet-4-5
# Postgres connection string (Neon / Supabase / Vercel Postgres).
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
