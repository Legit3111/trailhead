// Trailhead data model — the database IS the memory.
// Maps the old repo files: progress.json -> Progress, notes/ -> Note,
// quiz_log.md -> QuizResult, theory/ -> Phase artifacts, STUCK.md -> StuckLog.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ModuleStatus {
  locked
  available
  in_progress
  complete
}

enum PhaseKind {
  theory
  practical
  quiz
}

enum PhaseStatus {
  not_started
  in_progress
  complete
}

enum CurriculumStatus {
  draft      // generated, awaiting user approval/edits
  active
  archived
}

enum Role {
  user
  assistant
}

model Curriculum {
  id            String           @id @default(cuid())
  title         String
  subject       String
  description   String?
  goal          String?
  endTarget     String?
  // Per-curriculum tutor rules (e.g. the anti-jam verification protocol).
  tutorSystem   String?          @db.Text
  status        CurriculumStatus @default(draft)
  // Resume pointers — what "Continue" jumps to.
  currentModuleId String?
  currentPhase    PhaseKind?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  modules       Module[]
  messages      Message[]
  notes         Note[]
  quizResults   QuizResult[]
  stuckLogs     StuckLog[]
}

model Module {
  id           String       @id @default(cuid())
  curriculumId String
  curriculum   Curriculum   @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  orderIndex   Int
  title        String
  objectives   String?      @db.Text
  status       ModuleStatus @default(locked)
  phases       Phase[]
  messages     Message[]
  notes        Note[]
  quizResults  QuizResult[]

  @@unique([curriculumId, orderIndex])
  @@index([curriculumId])
}

model Phase {
  id        String      @id @default(cuid())
  moduleId  String
  module    Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  kind      PhaseKind
  status    PhaseStatus @default(not_started)
  // Free-form artifacts produced in this phase (theory summaries, etc.)
  artifact  String?     @db.Text
  messages  Message[]

  @@unique([moduleId, kind])
  @@index([moduleId])
}

// The running tutor conversation — replayed as resume context.
model Message {
  id           String     @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  moduleId     String?
  module       Module?    @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  phaseId      String?
  phase        Phase?     @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  role         Role
  content      String     @db.Text
  createdAt    DateTime   @default(now())

  @@index([curriculumId, createdAt])
  @@index([phaseId, createdAt])
}

model Note {
  id           String     @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  moduleId     String?
  module       Module?    @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  content      String     @db.Text
  createdAt    DateTime   @default(now())

  @@index([curriculumId])
}

model QuizResult {
  id           String     @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  moduleId     String?
  module       Module?    @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  score        Int
  total        Int
  details      String?    @db.Text // JSON: per-question breakdown
  createdAt    DateTime   @default(now())

  @@index([curriculumId])
}

model StuckLog {
  id           String     @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  entry        String     @db.Text
  resolved     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([curriculumId])
}
